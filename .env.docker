##############################
# PostgreSQL
##############################
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=mydatabase

##############################
# Приложение / SQLAlchemy
##############################
DATABASE_USER=blog_user
DATABASE_PASSWORD=2317
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=blog_db
DATABASE_URL=postgresql+psycopg2://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

##############################
# Redis & Celery
##############################
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

##############################
# Безопасность
##############################
SECRET_KEY=super-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

##############################
# CORS & BASE_URL
##############################
BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

##############################
# SMTP (MailHog)
##############################
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@localhost

##############################
# MinIO — общий корневой доступ
##############################
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

##############################
# MinIO — для вашего клиента
##############################
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=blog
MINIO_PUBLIC_BASE=http://localhost:9000
MINIO_SECURE=false

##############################
# Логирование
##############################
LOG_LEVEL=info
